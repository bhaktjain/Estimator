# Estimation Engine – Environment Configuration (REDACTED)
# Copy to .env and fill in real values. Do not commit .env.

# Required for pipeline and API
OPENAI_API_KEY=<REDACTED>

# Model (defaults used in code if not set)
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=

# Token and generation (pipeline uses --max_tokens in CLI; defaults below for reference)
MAX_TOKENS=10000
TEMPERATURE=0

# Chunking (used in run_chunked_estimation.py and process_transcript.py)
# Transcript chunk size (tokens) – set via CLI --max_tokens 1500 for transcript
CHUNK_SIZE=
CHUNK_OVERLAP=

# Vector DB – this pipeline does not use a vector DB (no Pinecone/Weaviate)
# VECTOR_DB_INDEX_NAME=
# PINECONE_API_KEY=
# WEAVIATE_URL=

# Optional – for archive Flask/FastAPI apps
PORT=5000
FLASK_ENV=production
